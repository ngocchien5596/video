# Chép file này thành .env rồi điền. File .env không đưa vào git.

# Token lấy từ @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=

# (Tuỳ chọn) Khoá bot vào một chat. Bỏ trống thì chat đầu tiên gõ /start sẽ được gắn.
TELEGRAM_CHAT_ID=

